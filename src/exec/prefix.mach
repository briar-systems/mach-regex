# finding the next place a match could begin
#
# a search with no thread alive can skip ahead. when every match begins with
# the same literal bytes, it scans for the rarest of them sixteen bytes at a
# time and checks the rest around it. when every match begins with one of at
# most three bytes, it scans for any of them.

use A: std.allocator;
use std.allocator.testing;
use std.math.bits;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;
use std.types.view.View;
use std.types.view.view;

use regex.compile;
use regex.compile.program;
use regex.compile.program.Prog;
use regex.syntax;

# how common each byte is in typical text, higher for more common, from the
# memchr crate's default ranking, which is in the public domain
val RANK: [256]u8 = [256]u8{
    55, 52, 51, 50, 49, 48, 47, 46, 45, 103, 242, 66, 67, 229, 44, 43,
    42, 41, 40, 39, 38, 37, 36, 35, 34, 33, 56, 32, 31, 30, 29, 28,
    255, 148, 164, 149, 136, 160, 155, 173, 221, 222, 134, 122, 232, 202, 215, 224,
    208, 220, 204, 187, 183, 179, 177, 168, 178, 200, 226, 195, 154, 184, 174, 126,
    120, 191, 157, 194, 170, 189, 162, 161, 150, 193, 142, 137, 171, 176, 185, 167,
    186, 112, 175, 192, 188, 156, 140, 143, 123, 133, 128, 147, 138, 146, 114, 223,
    151, 249, 216, 238, 236, 253, 227, 218, 230, 247, 135, 180, 241, 233, 246, 244,
    231, 139, 245, 243, 251, 235, 201, 196, 240, 214, 152, 182, 205, 181, 127, 27,
    212, 211, 210, 213, 228, 197, 169, 159, 131, 172, 105, 80, 98, 96, 97, 81,
    207, 145, 116, 115, 144, 130, 153, 121, 107, 132, 109, 110, 124, 111, 82, 108,
    118, 141, 113, 129, 119, 125, 165, 117, 92, 106, 83, 72, 99, 93, 65, 79,
    166, 237, 163, 199, 190, 225, 209, 203, 198, 217, 219, 206, 234, 248, 158, 239,
    255, 255, 255, 255, 255, 255, 255, 255, 255, 255, 255, 255, 255, 255, 255, 255,
    255, 255, 255, 255, 255, 255, 255, 255, 255, 255, 255, 255, 255, 255, 255, 255,
    255, 255, 255, 255, 255, 255, 255, 255, 255, 255, 255, 255, 255, 255, 255, 255,
    255, 255, 255, 255, 255, 255, 255, 255, 255, 255, 255, 255, 255, 255, 255, 255,
};

# the first position at or after from holding a byte, or the text's length
fun scan(text: View, from: usize, b: u8) usize {
    val needle: u8x16 = u8x16{b, b, b, b, b, b, b, b, b, b, b, b, b, b, b, b};
    var at:     usize = from;
    for (at + 16 <= text.len) {
        val chunk: u8x16 = text.data[at, 16]::u8x16;
        val hits:  u64x2 = (chunk == needle):~u64x2;
        # lane 0 is the lowest byte, so the first hit is the lowest set byte
        val low: u64 = hits[0];
        if (low != 0) { ret at + (bits.ctz(low) / 8)::usize; }
        val high: u64 = hits[1];
        if (high != 0) { ret at + 8 + (bits.ctz(high) / 8)::usize; }
        at = at + 16;
    }
    for (at < text.len && text.data[at] != b) { at = at + 1; }
    ret at;
}

# whether a search can skip ahead while no thread is alive
# ---
# p:   the program
# ret: whether it has a required prefix or a small set of first bytes
pub fun skips(p: *Prog) bool {
    ret p.prefix_len > 0 || p.first_count > 0;
}

# the first position at or after from holding any of two or three bytes, or the text's length
fun scan_any(text: View, from: usize, p: *Prog) usize {
    val b0: u8 = p.firsts[0];
    val b1: u8 = p.firsts[1];
    var b2: u8 = p.firsts[1];
    if (p.first_count == 3) { b2 = p.firsts[2]; }
    val n0: u8x16 = u8x16{b0, b0, b0, b0, b0, b0, b0, b0, b0, b0, b0, b0, b0, b0, b0, b0};
    val n1: u8x16 = u8x16{b1, b1, b1, b1, b1, b1, b1, b1, b1, b1, b1, b1, b1, b1, b1, b1};
    val n2: u8x16 = u8x16{b2, b2, b2, b2, b2, b2, b2, b2, b2, b2, b2, b2, b2, b2, b2, b2};
    var at: usize = from;
    for (at + 16 <= text.len) {
        val chunk: u8x16 = text.data[at, 16]::u8x16;
        val hits:  u64x2 = ((chunk == n0) | (chunk == n1) | (chunk == n2)):~u64x2;
        val low:   u64   = hits[0];
        if (low != 0) { ret at + (bits.ctz(low) / 8)::usize; }
        val high: u64 = hits[1];
        if (high != 0) { ret at + 8 + (bits.ctz(high) / 8)::usize; }
        at = at + 16;
    }
    for (at < text.len && text.data[at] != b0 && text.data[at] != b1 && text.data[at] != b2) { at = at + 1; }
    ret at;
}

# find the first position at or after from where the program's prefix begins,
# scanning for its rarest byte
fun literal(p: *Prog, text: View, from: usize, at: *usize) bool {
    val n:    usize = p.prefix_len::usize;
    var rare: usize = 0;
    var k:    usize = 1;
    for (k < n) {
        if (RANK[p.prefix[k]] < RANK[p.prefix[rare]]) { rare = k; }
        k = k + 1;
    }
    var here: usize = from;
    for (here + n <= text.len) {
        val hit: usize = scan(text, here + rare, p.prefix[rare]);
        if (hit - rare + n > text.len) { ret false; }
        val start: usize = hit - rare;
        k = 0;
        for (k < n && text.data[start + k] == p.prefix[k]) { k = k + 1; }
        if (k == n) {
            @at = start;
            ret true;
        }
        here = start + 1;
    }
    ret false;
}

# find the next position at or after from where a match could begin
# ---
# p:    a program that skips
# text: the text
# from: where to look from
# at:   where a match could begin, when there is such a place
# ret:  whether there is one
pub fun candidate(p: *Prog, text: View, from: usize, at: *usize) bool {
    if (p.prefix_len > 0) { ret literal(p, text, from, at); }
    var here: usize = 0;
    if (p.first_count == 1) { here = scan(text, from, p.firsts[0]); }
    or                      { here = scan_any(text, from, p); }
    if (here >= text.len)   { ret false; }
    @at = here;
    ret true;
}

# where the next candidate is for a pattern in a text, from a position, or the text's length for none
#[testing]
fun next_in(pattern: str, text: str, from: usize) usize {
    var t: testing.Testing;
    testing.make(?t);
    val a:     *A.Allocator                  = testing.allocator_of(?t);
    var flags: syntax.Flags;
    var tree:  res[syntax.Ast, syntax.Error] = syntax.parse(a, view(pattern, str_len(pattern)), flags, false);
    var found: usize                         = str_len(text);
    if (sel tree.ok) {
        var p: res[Prog, syntax.Error] = compile.compile(a, ?tree.ok);
        if (sel p.ok) {
            var at: usize = 0;
            if (skips(?p.ok) && candidate(?p.ok, view(text, str_len(text)), from, ?at)) { found = at; }
            program.dnit(?p.ok);
        }
        syntax.dnit(?tree.ok);
    }
    testing.dnit(?t);
    ret found;
}

test candidate__rarest_prefix_byte {
    # every other byte of cyrillic text is 0xd0 or 0xd1, the prefix's first
    val text: str = "\xd0\xb4\xd0\xb0 \xd0\xb4\xd0\xb0 \xd0\xa8\xd0\xb5\xd1\x80 \xd0\xa8\xd0\xb5\xd1\x80";
    if (next_in("\xd0\xa8\xd0\xb5\xd1\x80", text, 0) != 10)             { ret 1; }
    if (next_in("\xd0\xa8\xd0\xb5\xd1\x80", text, 11) != 17)            { ret 2; }
    if (next_in("\xd0\xa8\xd0\xb5\xd1\x80", text, 18) != str_len(text)) { ret 3; }
    ret 0;
}

test candidate__any_of_the_first_bytes {
    # past the first sixteen bytes, and in the tail shorter than sixteen
    val text: str = "xxxxxxxxxxxxxxxxxxxxs xx Sherlock";
    if (next_in("(?i)sherlock", text, 0) != 20)            { ret 1; }
    if (next_in("(?i)sherlock", text, 21) != 25)           { ret 2; }
    if (next_in("a|bc|c", "xxxxcxxxxxxxxxxxxxb", 0) != 4)  { ret 3; }
    if (next_in("a|bc|c", "xxxxcxxxxxxxxxxxxxb", 5) != 18) { ret 4; }
    ret 0;
}
