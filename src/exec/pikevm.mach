# the pike vm: every thread of the program in lockstep over the text
#
# each position holds a list of threads, one per instruction at most, in
# priority order, each with its own capture slots. a step moves every thread
# that consumes a byte into the next position's list, where the empty-width
# closure of each successor is followed at once. a list holds an instruction
# once, so a search takes time proportional to the program times the text,
# whatever the pattern. new threads start only at code point boundaries, and
# only until a match is found. when no thread is alive and the program has a
# required prefix or a small set of first bytes, the search jumps to the next
# place a match could begin. leftmost-first cuts the threads after a match,
# and leftmost-longest keeps them but drops any that started after it, as RE2
# does. all scratch is in a Cache sized for the program, so a search makes
# no allocation.

use A: std.allocator;
use std.collections.vector;
use std.collections.vector.Vector;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.result.res;
use std.types.size.usize;
use std.types.view.View;

use regex.compile.program;
use regex.compile.program.Assert;
use regex.compile.program.Inst;
use regex.compile.program.Prog;
use regex.exec.prefix;

# a capture slot no thread has set
pub val NONE: usize = 0xFFFFFFFFFFFFFFFF;

# a set of instructions in the order they were added, with each one's slots
# ---
# dense:  the members in priority order
# sparse: where each instruction sits in dense, meaningful only for members
# slots:  every instruction's slots, width to a row
# len:    how many members
rec List {
    dense:  Vector[u32];
    sparse: Vector[u32];
    slots:  Vector[usize];
    len:    usize;
}

# one step of the empty-width closure
# ---
# explore: follow an instruction
# restore: put a slot back as it was before a save was followed
tag Frame: u8 {
    explore: u32;
    restore: Restore;
}

# a slot's value to restore
# ---
# slot:  the slot
# value: its value before the save
rec Restore {
    slot:  u32;
    value: usize;
}

# the scratch of a search, sized for one program
# ---
# cur:    the threads at this position
# nxt:    the threads at the next position
# stack:  the closure's pending frames
# depth:  how many frames are pending
# thread: the slots of the thread being followed
# best:   the slots of the best match so far
# width:  the slots per thread
# size:   the program's instruction count it was sized for
# steps:  how many positions the last search stepped threads through
pub rec Cache {
    cur:    List;
    nxt:    List;
    stack:  Vector[Frame];
    depth:  usize;
    thread: Vector[usize];
    best:   Vector[usize];
    width:  usize;
    size:   usize;
    steps:  usize;
}

# grow a vector to n zeroed elements
fun sized[T](v: *Vector[T], n: usize) bool {
    val grown: res[usize, A.Error] = vector.ensure[T](v, n);
    if (sel grown.err) { ret false; }
    var zero: T;
    var k:    usize = 0;
    for (k < n) {
        v.data[k] = zero;
        k         = k + 1;
    }
    v.len = n;
    ret true;
}

fun list(a: *A.Allocator, size: usize, width: usize, l: *List) bool {
    l.dense  = vector.init[u32](a);
    l.sparse = vector.init[u32](a);
    l.slots  = vector.init[usize](a);
    l.len    = 0;
    ret sized[u32](?l.dense, size) && sized[u32](?l.sparse, size) && sized[usize](?l.slots, size * width);
}

fun list_dnit(l: *List) {
    vector.dnit[u32](?l.dense);
    vector.dnit[u32](?l.sparse);
    vector.dnit[usize](?l.slots);
}

# make the scratch for searching a program
# ---
# a:   the allocator the scratch lives in
# p:   the program
# c:   the cache to fill
# ret: false when the allocator refuses, leaving nothing held
pub fun init(a: *A.Allocator, p: *Prog, c: *Cache) bool {
    val size:  usize = p.insts.len;
    val width: usize = p.slots::usize;
    c.width  = width;
    c.size   = size;
    c.depth  = 0;
    c.stack  = vector.init[Frame](a);
    c.thread = vector.init[usize](a);
    c.best   = vector.init[usize](a);
    var ok: bool = list(a, size, width, ?c.cur);
    ok = list(a, size, width, ?c.nxt) && ok;
    # each instruction is explored at most once per closure and pushes at most one restore
    ok = sized[Frame](?c.stack, size * 2 + 1) && ok;
    ok = sized[usize](?c.thread, width) && ok;
    ok = sized[usize](?c.best, width) && ok;
    if (!ok) { dnit(c); }
    ret ok;
}

# release a cache's scratch
# ---
# c: the cache
pub fun dnit(c: *Cache) {
    list_dnit(?c.cur);
    list_dnit(?c.nxt);
    vector.dnit[Frame](?c.stack);
    vector.dnit[usize](?c.thread);
    vector.dnit[usize](?c.best);
}

fun contains(l: *List, pc: u32) bool {
    val at: u32 = l.sparse.data[pc];
    ret at::usize < l.len && l.dense.data[at] == pc;
}

fun insert(l: *List, pc: u32) {
    l.sparse.data[pc]   = l.len::u32;
    l.dense.data[l.len] = pc;
    l.len               = l.len + 1;
}

fun is_word(b: u8) bool {
    ret (b >= '0' && b <= '9') || (b >= 'A' && b <= 'Z') || (b >= 'a' && b <= 'z') || b == '_';
}

# whether an assertion holds at a position of the text
# ---
# a:    the assertion
# text: the text
# at:   the position
# ret:  whether it holds there
pub fun holds(a: Assert, text: View, at: usize) bool {
    if (sel a.begin_text) { ret at == 0; }
    if (sel a.end_text)   { ret at == text.len; }
    if (sel a.begin_line) { ret at == 0 || text.data[at - 1] == '\n'; }
    if (sel a.end_line)   { ret at == text.len || text.data[at] == '\n'; }
    val before: bool = at > 0 && is_word(text.data[at - 1]);
    val after:  bool = at < text.len && is_word(text.data[at]);
    if (sel a.word_boundary) { ret before != after; }
    ret before == after;
}

# whether a position does not split a utf-8 sequence
# ---
# text: the text
# at:   the position
# ret:  whether a code point may begin there
pub fun boundary(text: View, at: usize) bool {
    ret at == 0 || at >= text.len || (text.data[at] & 0xC0) != 0x80;
}

fun push(c: *Cache, f: Frame) {
    c.stack.data[c.depth] = f;
    c.depth               = c.depth + 1;
}

# add pc's empty-width closure at a position to a list, with the slots in c.thread
#
# active is how many slots are recorded, so a search that needs only the match
# bounds carries two.
fun add(p: *Prog, c: *Cache, l: *List, start: u32, text: View, at: usize, active: usize) {
    c.depth = 0;
    push(c, Frame.explore{start});
    for (c.depth > 0) {
        c.depth = c.depth - 1;
        val f: Frame = c.stack.data[c.depth];
        if (sel f.restore) {
            c.thread.data[f.restore.slot] = f.restore.value;
            cnt;
        }
        if (sel f.explore) {
            var pc: u32 = f.explore;
            for {
                if (contains(l, pc)) { brk; }
                insert(l, pc);
                val i: Inst = p.insts.data[pc];
                if (sel i.split) {
                    push(c, Frame.explore{i.split.y});
                    pc = i.split.x;
                    cnt;
                }
                if (sel i.save) {
                    if (i.save.slot::usize < active) {
                        push(c, Frame.restore{Restore{slot: i.save.slot, value: c.thread.data[i.save.slot]}});
                        c.thread.data[i.save.slot] = at;
                    }
                    pc = i.save.next;
                    cnt;
                }
                if (sel i.look) {
                    if (!holds(i.look.assert, text, at)) { brk; }
                    pc = i.look.next;
                    cnt;
                }
                if (sel i.fail) { brk; }
                # a thread that waits on a byte or a match keeps its slots in the list
                var k: usize = 0;
                for (k < active) {
                    l.slots.data[pc::usize * c.width + k] = c.thread.data[k];
                    k                                     = k + 1;
                }
                brk;
            }
        }
    }
}

# search a text for the program's match
#
# the best match's slots are left in out, the first active of them, with
# NONE for a group that took no part.
# ---
# p:        the program
# c:        scratch sized for the program
# text:     the text
# start:    where the search begins, a code point boundary
# anchored: a match must begin at start
# longest:  leftmost-longest rather than leftmost-first
# active:   how many slots to record, at least 2 and at most the program's
# out:      where the slots of the match go, active of them
# ret:      whether there is a match
pub fun search(p: *Prog, c: *Cache, text: View, start: usize, anchored: bool, longest: bool, active: usize, out: *usize) bool {
    ret search_within(p, c, text, start, text.len, anchored, longest, active, out);
}

# search a text for the program's match, reading no byte at or past limit
#
# assertions still see the whole text, so a match known to end by limit is
# found with the same groups, as when the lazy dfas have found its bounds.
# ---
# p:        the program
# c:        scratch sized for the program
# text:     the text
# start:    where the search begins, a code point boundary
# limit:    where reading stops, at most the text's length
# anchored: a match must begin at start
# longest:  leftmost-longest rather than leftmost-first
# active:   how many slots to record, at least 2 and at most the program's
# out:      where the slots of the match go, active of them
# ret:      whether there is a match
pub fun search_within(p: *Prog, c: *Cache, text: View, start: usize, limit: usize, anchored: bool, longest: bool, active: usize, out: *usize) bool {
    var cur:     *List = ?c.cur;
    var nxt:     *List = ?c.nxt;
    var matched: bool  = false;
    var at:      usize = start;
    cur.len = 0;
    c.steps = 0;
    for {
        # with nothing running, no match can begin before the prefix's next occurrence
        if (!matched && !anchored && cur.len == 0 && prefix.skips(p)) {
            if (!prefix.candidate(p, text, at, ?at)) { brk; }
        }
        # a new thread starting here, after every thread already running
        if (!matched && (at == start || !anchored) && boundary(text, at)) {
            var k: usize = 0;
            for (k < active) {
                c.thread.data[k] = NONE;
                k                = k + 1;
            }
            add(p, c, cur, p.start, text, at, active);
        }
        if (cur.len == 0) {
            if (matched || anchored || at >= limit) { brk; }
            at = at + 1;
            cnt;
        }
        c.steps = c.steps + 1;
        nxt.len = 0;
        var t: usize = 0;
        for (t < cur.len) {
            val pc:  u32   = cur.dense.data[t];
            val row: usize = pc::usize * c.width;
            t = t + 1;
            # a leftmost-longest thread that began after the best match cannot win
            if (longest && matched && cur.slots.data[row] > c.best.data[0]) { cnt; }
            val i: Inst = p.insts.data[pc];
            if (sel i.match) {
                val begin: usize = cur.slots.data[row];
                if (!longest || !matched || begin < c.best.data[0] || (begin == c.best.data[0] && at > c.best.data[1])) {
                    var k: usize = 0;
                    for (k < active) {
                        c.best.data[k] = cur.slots.data[row + k];
                        k              = k + 1;
                    }
                    matched = true;
                }
                # leftmost-first prefers this thread to every one after it
                if (!longest) { brk; }
                cnt;
            }
            if (at >= limit) { cnt; }
            val b:    u8  = text.data[at];
            var next: u32 = 0;
            if (!program.step(p, i, b, ?next)) { cnt; }
            var k: usize = 0;
            for (k < active) {
                c.thread.data[k] = cur.slots.data[row + k];
                k                = k + 1;
            }
            add(p, c, nxt, next, text, at + 1, active);
        }
        val swap: *List = cur;
        cur = nxt;
        nxt = swap;
        if (at >= limit) { brk; }
        at = at + 1;
    }
    if (!matched) { ret false; }
    var k: usize = 0;
    for (k < active) {
        out[k] = c.best.data[k];
        k      = k + 1;
    }
    ret true;
}
