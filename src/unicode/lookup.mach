# lookups over the generated unicode tables: class names and case folding

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.option.opt;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;
use std.types.view.View;
use std.types.view.view;

use regex.unicode.classes;
use regex.unicode.folds;

# an inclusive range of code points
# ---
# lo: first code point
# hi: last code point, at least lo
pub rec Range {
    lo: u32;
    hi: u32;
}

# a borrowed view of a static range table, sorted and non-overlapping
# ---
# ranges: the first range
# len:    number of ranges
pub rec Table {
    ranges: *Range;
    len:    usize;
}

# order a view against a null-terminated name by byte
# ---
# name: the view
# key:  the null-terminated name
# ret:  negative, zero or positive as name sorts before, equal to or after key
fun compare(name: View, key: *u8) i64 {
    var i: usize = 0;
    for (i < name.len) {
        if (key[i] == 0)            { ret 1; }
        if (name.data[i] != key[i]) { ret name.data[i]::i64 - key[i]::i64; }
        i = i + 1;
    }
    if (key[i] == 0) { ret 0; }
    ret -1;
}

# the table of a class name as RE2 accepts it: a general category, a script or Any
# ---
# name: the class name, case-sensitive
# ret:  the class's table, or none for an unknown name
pub fun class(name: View) opt[Table] {
    var lo: u32 = 0;
    var hi: u32 = classes.COUNT;
    for (lo < hi) {
        val mid:   u32 = lo + (hi - lo) / 2;
        val order: i64 = compare(name, classes.NAMES[mid]);
        if (order == 0) {
            val first: *u32 = ?classes.RANGES[classes.STARTS[mid] * 2];
            ret opt[Table].some{Table{ranges: first::*Range, len: classes.COUNTS[mid]::usize}};
        }
        or (order < 0) {
            hi = mid;
        }
        or {
            lo = mid + 1;
        }
    }
    ret opt[Table].none{};
}

# the next code point in cp's simple case folding orbit, as go's unicode.SimpleFold
# ---
# cp:  a code point
# ret: the smallest code point in the orbit greater than cp, else the smallest in the
#      orbit, or cp itself when it has no fold
pub fun simple_fold(cp: u32) u32 {
    var lo: u32 = 0;
    var hi: u32 = folds.COUNT;
    for (lo < hi) {
        val mid: u32 = lo + (hi - lo) / 2;
        val key: u32 = folds.FOLDS[mid * 2];
        if (key == cp) { ret folds.FOLDS[mid * 2 + 1]; }
        or (cp < key) {
            hi = mid;
        }
        or {
            lo = mid + 1;
        }
    }
    ret cp;
}

#[testing]
fun table(name: str) opt[Table] {
    ret class(view(name, str_len(name)));
}

#[testing]
fun known(name: str) bool {
    val t: opt[Table] = table(name);
    ret sel t.some;
}

#[testing]
fun contains(name: str, cp: u32) bool {
    val t: opt[Table] = table(name);
    if (sel t.none) { ret false; }
    var i: usize = 0;
    for (i < t.some.len) {
        if (cp >= t.some.ranges[i].lo && cp <= t.some.ranges[i].hi) { ret true; }
        i = i + 1;
    }
    ret false;
}

test class__categories {
    if (!contains("Lu", 'A') || contains("Lu", 'a') || !contains("Ll", 'a'))        { ret 1; }
    if (!contains("L", 'a') || !contains("L", 0x4E00) || contains("L", '0'))        { ret 2; }
    if (!contains("Nd", '9') || !contains("Nd", 0x0660) || contains("Nd", 'a'))     { ret 3; }
    if (!contains("N", 0x2167) || !contains("Cs", 0xDBFF) || contains("C", 0x0378)) { ret 4; }
    val nd: opt[Table] = table("Nd");
    if (sel nd.none)                                                { ret 5; }
    if (nd.some.ranges[0].lo != '0' || nd.some.ranges[0].hi != '9') { ret 6; }
    ret 0;
}

test class__scripts {
    if (!contains("Greek", 0x03B1) || contains("Greek", 'a') || !contains("Latin", 'a'))        { ret 1; }
    if (!contains("Han", 0x4E00) || !contains("Common", '0') || !contains("Inherited", 0x0300)) { ret 2; }
    ret 0;
}

test class__any_and_unknown {
    val any: opt[Table] = table("Any");
    if (sel any.none)                                                                         { ret 1; }
    if (any.some.len != 1 || any.some.ranges[0].lo != 0 || any.some.ranges[0].hi != 0x10FFFF) { ret 2; }
    if (known("greek") || known("Gree") || known("Greeks") || known(""))                      { ret 3; }
    ret 0;
}

test simple_fold__orbits {
    if (simple_fold('K') != 'k' || simple_fold('k') != 0x212A || simple_fold(0x212A) != 'K') { ret 1; }
    if (simple_fold('A') != 'a' || simple_fold('a') != 'A')                                  { ret 2; }
    if (simple_fold('1') != '1' || simple_fold(0x10FFFF) != 0x10FFFF)                        { ret 3; }
    ret 0;
}
