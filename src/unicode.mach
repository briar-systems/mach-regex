# unicode general categories, scripts and simple case folding, generated from the ucd
#
# class resolves a `\p{Name}` class name to its range table and simple_fold walks a
# code point's case folding orbit. the data is generated by tools/unicode-tables at
# the unicode version VERSION names.

use regex.unicode.lookup;
use regex.unicode.version;

fwd lookup.Range;
fwd lookup.Table;
fwd lookup.class;
fwd lookup.simple_fold;
fwd version.VERSION;
