# searching through the public api: matches, captures, iteration and the cache

use std.allocator;
use std.allocator.testing;
use std.collections.vector;
use std.collections.vector.Vector;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;
use std.types.view.View;
use std.types.view.view;

use regex.lib.regex;

# a compiled pattern and its cache, over the testing allocator
rec Fixture {
    t:  testing.Testing;
    re: regex.Regex;
    c:  regex.Cache;
    ok: bool;
}

#[testing]
fun text(s: str) View {
    ret view(s, str_len(s));
}

#[testing]
fun open(f: *Fixture, pattern: str, o: regex.Options) {
    testing.make(?f.t);
    val a:  *allocator.Allocator          = testing.allocator_of(?f.t);
    val re: res[regex.Regex, regex.Error] = regex.compile_with(a, text(pattern), o);
    f.ok = false;
    if (sel re.err) { ret; }
    f.re = re.ok;
    val c: res[regex.Cache, regex.Error] = regex.cache(a, ?f.re);
    if (sel c.err) {
        regex.dnit(?f.re);
        ret;
    }
    f.c  = c.ok;
    f.ok = true;
}

#[testing]
fun close(f: *Fixture) bool {
    if (f.ok) {
        regex.cache_dnit(?f.c);
        regex.dnit(?f.re);
    }
    val clean: bool = !testing.leaked(?f.t);
    testing.dnit(?f.t);
    ret clean;
}

# whether the first match at or after from is exactly start..end
#[testing]
fun finds(f: *Fixture, s: str, from: usize, start: usize, end: usize) bool {
    val m: opt[regex.Match] = regex.find(?f.re, ?f.c, text(s), from);
    if (sel m.none) { ret false; }
    ret m.some.start == start && m.some.end == end;
}

#[testing]
fun misses(f: *Fixture, s: str, from: usize) bool {
    val m: opt[regex.Match] = regex.find(?f.re, ?f.c, text(s), from);
    ret sel m.none;
}

test find__leftmost_first_and_longest {
    var o: regex.Options;
    var f: Fixture;
    open(?f, "a|ab", o);
    if (!f.ok || !finds(?f, "xab", 0, 1, 2)) { ret 1; }
    if (!close(?f))                          { ret 2; }
    o.longest = true;
    open(?f, "a|ab", o);
    if (!f.ok || !finds(?f, "xab", 0, 1, 3)) { ret 3; }
    if (!close(?f))                          { ret 4; }
    o.longest = false;
    open(?f, "a+?", o);
    if (!f.ok || !finds(?f, "aaa", 0, 0, 1)) { ret 5; }
    if (!close(?f))                          { ret 6; }
    open(?f, "b", o);
    if (!f.ok || !finds(?f, "abab", 2, 3, 4) || !misses(?f, "abab", 4)) { ret 7; }
    if (!close(?f))                                                     { ret 8; }
    ret 0;
}

test find__anchors_and_boundaries {
    var o: regex.Options;
    var f: Fixture;
    open(?f, "^b", o);
    # ^ is the start of the text, not of the search
    if (!f.ok || !misses(?f, "ab", 1)) { ret 1; }
    if (!close(?f))                    { ret 2; }
    o.multi_line = true;
    open(?f, "^b$", o);
    if (!f.ok || !finds(?f, "a\nb\nc", 0, 2, 3)) { ret 3; }
    if (!close(?f))                              { ret 4; }
    o.multi_line = false;
    open(?f, "\\bcat\\b", o);
    if (!f.ok || !finds(?f, "concat cat", 0, 7, 10)) { ret 5; }
    if (!close(?f))                                  { ret 6; }
    open(?f, "b$", o);
    # $ without (?m) is only the end of the text, not before a final newline
    if (!f.ok || !misses(?f, "ab\n", 0)) { ret 7; }
    if (!close(?f))                      { ret 8; }
    ret 0;
}

test find__utf8_text {
    var o: regex.Options;
    var f: Fixture;
    open(?f, "\\x{e9}.", o);
    if (!f.ok || !finds(?f, "caf\xC3\xA9\xE2\x82\xAC!", 0, 3, 8)) { ret 1; }
    if (!close(?f))                                               { ret 2; }
    open(?f, "a.b", o);
    # . never matches an invalid byte
    if (!f.ok || !misses(?f, "a\xFFb", 0)) { ret 3; }
    if (!close(?f))                        { ret 4; }
    open(?f, "x*", o);
    # a search from inside a code point starts at the next boundary
    if (!f.ok || !finds(?f, "\xC3\xA9", 1, 2, 2)) { ret 5; }
    if (!close(?f))                               { ret 6; }
    ret 0;
}

test captures__groups_and_names {
    var o: regex.Options;
    var f: Fixture;
    open(?f, "(a)(?P<b>b)?(c)", o);
    if (!f.ok || regex.group_count(?f.re) != 3 || regex.slot_count(?f.re) != 8) { ret 1; }
    var slots: [8]usize;
    if (!regex.captures(?f.re, ?f.c, text("xac"), 0, ?slots[0]))                            { ret 2; }
    if (slots[0] != 1 || slots[1] != 3 || slots[2] != 1 || slots[3] != 2)                   { ret 3; }
    if (slots[4] != regex.NONE || slots[5] != regex.NONE || slots[6] != 2 || slots[7] != 3) { ret 4; }
    val b: opt[usize] = regex.group_index(?f.re, text("b"));
    if (sel b.none)  { ret 5; }
    if (b.some != 2) { ret 6; }
    val missing: opt[usize] = regex.group_index(?f.re, text("zz"));
    if (sel missing.some)                                                           { ret 7; }
    if (regex.group_name(?f.re, 2).len != 1 || regex.group_name(?f.re, 1).len != 0) { ret 8; }
    if (!close(?f))                                                                 { ret 9; }
    ret 0;
}

test next__iterates_as_go_does {
    var o: regex.Options;
    var f: Fixture;
    open(?f, "a*", o);
    if (!f.ok) { ret 1; }
    # "baaa" gives the empty match at 0 and aaa, never the empty match right after it
    var it:  regex.Iter       = regex.iter();
    val one: opt[regex.Match] = regex.next(?f.re, ?f.c, text("baaa"), ?it);
    val two: opt[regex.Match] = regex.next(?f.re, ?f.c, text("baaa"), ?it);
    val end: opt[regex.Match] = regex.next(?f.re, ?f.c, text("baaa"), ?it);
    if (sel one.none)                                                                         { ret 2; }
    if (sel two.none)                                                                         { ret 2; }
    if (sel end.some)                                                                         { ret 2; }
    if (one.some.start != 0 || one.some.end != 0 || two.some.start != 1 || two.some.end != 4) { ret 3; }
    if (!close(?f))                                                                           { ret 4; }
    ret 0;
}

test search__linear_on_a_pathological_pattern {
    var o: regex.Options;
    var f: Fixture;
    open(?f, "(a*)*b", o);
    if (!f.ok) { ret 1; }
    var run: [20001]u8;
    var k:   usize = 0;
    for (k < 20000) {
        run[k] = 'a';
        k      = k + 1;
    }
    run[20000] = 0;
    if (!misses(?f, ?run[0], 0)) { ret 2; }
    if (!close(?f))              { ret 3; }
    ret 0;
}

test search__makes_no_allocation {
    var o: regex.Options;
    var f: Fixture;
    open(?f, "(\\w+)@(\\w+)\\.com", o);
    if (!f.ok) { ret 1; }
    val before: usize = testing.total_count(?f.t);
    var slots:  [6]usize;
    if (!regex.captures(?f.re, ?f.c, text("mail me at ann@example.com"), 0, ?slots[0])) { ret 2; }
    if (!regex.is_match(?f.re, ?f.c, text("bob@site.com")))                             { ret 3; }
    if (testing.total_count(?f.t) != before)                                            { ret 4; }
    if (slots[2] != 11 || slots[3] != 14)                                               { ret 5; }
    if (!close(?f))                                                                     { ret 6; }
    ret 0;
}

test compile__options_and_errors {
    var o: regex.Options;
    var f: Fixture;
    o.case_insensitive = true;
    o.dot_all          = true;
    open(?f, "k.", o);
    if (!f.ok || !finds(?f, "\xE2\x84\xAA\n", 0, 0, 4)) { ret 1; }
    if (!close(?f))                                     { ret 2; }
    var lit: regex.Options;
    lit.literal = true;
    open(?f, "a.b*", lit);
    if (!f.ok || !finds(?f, "xa.b*", 0, 1, 5) || !misses(?f, "aab", 0)) { ret 3; }
    if (!close(?f))                                                     { ret 4; }
    var t: testing.Testing;
    testing.make(?t);
    val bad: res[regex.Regex, regex.Error] = regex.compile(testing.allocator_of(?t), text("a(b"));
    if (sel bad.ok)                                                     { ret 5; }
    if (bad.err.offset != 1 || str_len(regex.error_text(bad.err)) == 0) { ret 6; }
    testing.dnit(?t);
    ret 0;
}

test quote__matches_its_text_exactly {
    var t: testing.Testing;
    testing.make(?t);
    val a:   *allocator.Allocator = testing.allocator_of(?t);
    var out: Vector[u8]           = vector.init[u8](a);
    val raw: str                  = "1+1=2? (a|b) [x] {y} ^$ \\ .*";
    if (!regex.quote(text(raw), ?out)) { ret 1; }
    val re: res[regex.Regex, regex.Error] = regex.compile(a, view(out.data, out.len));
    if (sel re.err) { ret 2; }
    var r: regex.Regex                   = re.ok;
    val c: res[regex.Cache, regex.Error] = regex.cache(a, ?r);
    if (sel c.err) { ret 3; }
    var cache: regex.Cache      = c.ok;
    val m:     opt[regex.Match] = regex.find(?r, ?cache, text(raw), 0);
    if (sel m.none)                                      { ret 4; }
    if (m.some.start != 0 || m.some.end != str_len(raw)) { ret 5; }
    regex.cache_dnit(?cache);
    regex.dnit(?r);
    vector.dnit[u8](?out);
    if (testing.leaked(?t)) { ret 6; }
    testing.dnit(?t);
    ret 0;
}

test search__prefix_scan_steps_only_at_candidates {
    var o: regex.Options;
    var f: Fixture;
    open(?f, "(hello) \\w+", o);
    if (!f.ok || f.re.prog.prefix_len != 6) { ret 1; }
    # a decoy that shares the first bytes, then the match past a long run of filler
    var big: [10020]u8;
    var k:   usize = 0;
    for (k < 10000) {
        big[k] = 'x';
        k      = k + 1;
    }
    big[5000] = 'h';
    big[5001] = 'e';
    big[5002] = 'l';
    big[5003] = 'p';
    val tail: str = "hello world";
    k = 0;
    for (k < 11) {
        big[10000 + k] = tail[k];
        k              = k + 1;
    }
    big[10011] = 0;
    if (!finds(?f, ?big[0], 0, 10000, 10011)) { ret 2; }
    # the vm ran only from the one candidate through the match
    if (f.c.vm.steps > 16) { ret 3; }
    if (!close(?f))        { ret 4; }
    # no prefix is taken past a choice, a fold or an assertion
    open(?f, "(?i)hello", o);
    if (!f.ok || f.re.prog.prefix_len != 0) { ret 5; }
    if (!close(?f))                         { ret 6; }
    open(?f, "ab|ac", o);
    if (!f.ok || f.re.prog.prefix_len != 0) { ret 7; }
    if (!close(?f))                         { ret 8; }
    open(?f, "^ab", o);
    if (!f.ok || f.re.prog.prefix_len != 0) { ret 9; }
    if (!close(?f))                         { ret 10; }
    ret 0;
}
