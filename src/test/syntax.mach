# the parser, checked through a compact dump of the Ast it builds
#
# the dump names each node briefly: lit{a} for a literal, with /i when it folds,
# cc{...} for a class listing its items (ranges as lo-hi in hex, a negated set as
# ^{...}, and \p{Name} or \P{Name}), ncc for a negated class, cap{n:...} and
# cap{n<name>:...} for groups, rep{min,max:...} with ? for a lazy one and max *
# for unbounded, cat{...} and alt{a|b}, and dot, dnl, bol, eol, bot, eot, wb and
# nwb for the empty-width and any-character nodes.

use std.allocator;
use std.allocator.testing;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_equals;
use std.types.string.str_len;
use std.types.view.View;
use std.types.view.view;

use regex.syntax;

# a byte buffer the dump writes into, null-terminated as it goes
rec Buf {
    data: [4096]u8;
    len:  usize;
}

#[testing]
fun byte(b: *Buf, c: u8) {
    if (b.len + 1 >= 4096) { ret; }
    b.data[b.len] = c;
    b.len         = b.len + 1;
    b.data[b.len] = 0;
}

#[testing]
fun text(b: *Buf, s: str) {
    var i: usize = 0;
    for (s[i] != 0) {
        byte(b, s[i]);
        i = i + 1;
    }
}

#[testing]
fun hexnum(b: *Buf, v: u32) {
    val digits: str  = "0123456789abcdef";
    var shift:  u32  = 28;
    var seen:   bool = false;
    for {
        val d: u32 = (v >> shift) & 0xF;
        if (d != 0 || seen || shift == 0) {
            byte(b, digits[d]);
            seen = true;
        }
        if (shift == 0) { brk; }
        shift = shift - 4;
    }
}

#[testing]
fun decimal(b: *Buf, v: u32) {
    if (v >= 10) { decimal(b, v / 10); }
    byte(b, '0' + (v % 10)::u8);
}

#[testing]
fun viewtext(b: *Buf, v: View) {
    var i: usize = 0;
    for (i < v.len) {
        byte(b, v.data[i]);
        i = i + 1;
    }
}

# a code point as itself when printable ascii, else as \x{..}
#[testing]
fun cp(b: *Buf, c: u32) {
    if (c > 0x20 && c < 0x7F) {
        byte(b, c::u8);
        ret;
    }
    text(b, "\\x{");
    hexnum(b, c);
    byte(b, '}');
}

#[testing]
fun kids(b: *Buf, t: *syntax.Ast, s: syntax.Span, sep: str) {
    var k: usize = 0;
    for (k < s.len) {
        if (k > 0) { text(b, sep); }
        dump(b, t, t.kids.data[s.start + k]);
        k = k + 1;
    }
}

#[testing]
fun class(b: *Buf, t: *syntax.Ast, c: syntax.Class) {
    if (c.negated) { byte(b, 'n'); }
    text(b, "cc");
    if (c.fold) { text(b, "/i"); }
    byte(b, '{');
    var k: usize = 0;
    for (k < c.items.len) {
        if (k > 0) { byte(b, ' '); }
        val item: syntax.Item = t.items.data[c.items.start + k];
        if (sel item.unicode) {
            if (item.unicode.negated) { text(b, "\\P{"); }
            or                        { text(b, "\\p{"); }
            viewtext(b, item.unicode.name);
            byte(b, '}');
            k = k + 1;
            cnt;
        }
        if (item.set.negated) { text(b, "^{"); }
        var r: usize = 0;
        for (r < item.set.ranges.len) {
            if (r > 0) { byte(b, ' '); }
            val range: syntax.Range = t.ranges.data[item.set.ranges.start + r];
            hexnum(b, range.lo);
            byte(b, '-');
            hexnum(b, range.hi);
            r = r + 1;
        }
        if (item.set.negated) { byte(b, '}'); }
        k = k + 1;
    }
    byte(b, '}');
}

#[testing]
fun dump(b: *Buf, t: *syntax.Ast, i: usize) {
    val n: syntax.Node = t.nodes.data[i];
    if (sel n.empty) {
        text(b, "emp{}");
        ret;
    }
    if (sel n.any) {
        text(b, "dot{}");
        ret;
    }
    if (sel n.any_but_newline) {
        text(b, "dnl{}");
        ret;
    }
    if (sel n.begin_line) {
        text(b, "bol{}");
        ret;
    }
    if (sel n.end_line) {
        text(b, "eol{}");
        ret;
    }
    if (sel n.begin_text) {
        text(b, "bot{}");
        ret;
    }
    if (sel n.end_text) {
        text(b, "eot{}");
        ret;
    }
    if (sel n.word_boundary) {
        text(b, "wb{}");
        ret;
    }
    if (sel n.not_word_boundary) {
        text(b, "nwb{}");
        ret;
    }
    if (sel n.literal) {
        text(b, "lit");
        if (n.literal.fold) { text(b, "/i"); }
        byte(b, '{');
        cp(b, n.literal.cp);
        byte(b, '}');
        ret;
    }
    if (sel n.class) {
        class(b, t, t.classes.data[n.class]);
        ret;
    }
    if (sel n.capture) {
        text(b, "cap{");
        decimal(b, n.capture.index);
        if (n.capture.name.len > 0) {
            byte(b, '<');
            viewtext(b, n.capture.name);
            byte(b, '>');
        }
        byte(b, ':');
        dump(b, t, n.capture.sub);
        byte(b, '}');
        ret;
    }
    if (sel n.repeat) {
        text(b, "rep{");
        decimal(b, n.repeat.min);
        byte(b, ',');
        if (n.repeat.max == syntax.UNBOUNDED) { byte(b, '*'); }
        or                                    { decimal(b, n.repeat.max); }
        if (!n.repeat.greedy)                 { byte(b, '?'); }
        byte(b, ':');
        dump(b, t, n.repeat.sub);
        byte(b, '}');
        ret;
    }
    if (sel n.concat) {
        text(b, "cat{");
        kids(b, t, n.concat, "");
        byte(b, '}');
        ret;
    }
    if (sel n.alternate) {
        text(b, "alt{");
        kids(b, t, n.alternate, "|");
        byte(b, '}');
    }
}

#[testing]
fun parse_with(a: *allocator.Allocator, pattern: str, flags: syntax.Flags) res[syntax.Ast, syntax.Error] {
    ret syntax.parse(a, view(pattern, str_len(pattern)), flags, false);
}

# whether a pattern parses to the expected dump, and releases all it took
#[testing]
fun parses(pattern: str, want: str) bool {
    var t: testing.Testing;
    testing.make(?t);
    var flags: syntax.Flags;
    var got:   res[syntax.Ast, syntax.Error] = parse_with(testing.allocator_of(?t), pattern, flags);
    if (sel got.err) {
        testing.dnit(?t);
        ret false;
    }
    var b: Buf;
    b.len = 0;
    dump(?b, ?got.ok, got.ok.root);
    val same: bool = str_equals(?b.data[0], want);
    syntax.dnit(?got.ok);
    val clean: bool = !testing.leaked(?t);
    testing.dnit(?t);
    ret same && clean;
}

# whether a pattern fails with the expected message at the expected offset
#[testing]
fun fails(pattern: str, message: str, offset: usize) bool {
    var t: testing.Testing;
    testing.make(?t);
    var flags: syntax.Flags;
    val got:   res[syntax.Ast, syntax.Error] = parse_with(testing.allocator_of(?t), pattern, flags);
    if (sel got.ok) {
        testing.dnit(?t);
        ret false;
    }
    val right: bool = str_equals(syntax.text(got.err.kind), message) && got.err.offset == offset;
    val clean: bool = !testing.leaked(?t);
    testing.dnit(?t);
    ret right && clean;
}

test parse__literals_and_operators {
    if (!parses("abc", "cat{lit{a}lit{b}lit{c}}"))                                          { ret 1; }
    if (!parses("a|b|", "alt{lit{a}|lit{b}|emp{}}"))                                        { ret 2; }
    if (!parses("a*b+?c??", "cat{rep{0,*:lit{a}}rep{1,*?:lit{b}}rep{0,1?:lit{c}}}"))        { ret 3; }
    if (!parses("a{2}b{2,}c{2,5}?", "cat{rep{2,2:lit{a}}rep{2,*:lit{b}}rep{2,5?:lit{c}}}")) { ret 4; }
    if (!parses("a{,5}", "cat{lit{a}lit{{}lit{,}lit{5}lit{}}}"))                            { ret 5; }
    if (!parses("x{01}", "cat{lit{x}lit{{}lit{0}lit{1}lit{}}}"))                            { ret 6; }
    if (!parses("\xC3\xA9.", "cat{lit{\\x{e9}}dnl{}}"))                                     { ret 7; }
    if (!parses("", "emp{}"))                                                               { ret 8; }
    ret 0;
}

test parse__groups_and_flags {
    if (!parses("(a)(?:b)(?P<x>c)(?<y>d)", "cat{cap{1:lit{a}}lit{b}cap{2<x>:lit{c}}cap{3<y>:lit{d}}}")) { ret 1; }
    if (!parses("(?i)a(?-i:b)c", "cat{lit/i{a}lit{b}lit/i{c}}"))                                        { ret 2; }
    if (!parses("(a(?i)b)c", "cat{cap{1:cat{lit{a}lit/i{b}}}lit{c}}"))                                  { ret 3; }
    if (!parses("(?s).(?U)a*a*?", "cat{dot{}rep{0,*?:lit{a}}rep{0,*:lit{a}}}"))                         { ret 4; }
    if (!parses("^$(?m)^$", "cat{bot{}eot{}bol{}eol{}}"))                                               { ret 5; }
    if (!parses("\\A\\z\\b\\B", "cat{bot{}eot{}wb{}nwb{}}"))                                            { ret 6; }
    if (!parses("()", "cap{1:emp{}}"))                                                                  { ret 7; }
    ret 0;
}

test parse__classes {
    if (!parses("[a-c\\d]", "cc{30-39 61-63}"))                                                                         { ret 1; }
    if (!parses("[^]a-]", "ncc{5d-5d 61-61 2d-2d}"))                                                                    { ret 2; }
    if (!parses("[[:alpha:][:^digit:]]", "cc{41-5a 61-7a ^{30-39}}"))                                                   { ret 3; }
    if (!parses("\\W\\pL\\P{Greek}\\p{^Lu}", "cat{cc{^{30-39 41-5a 5f-5f 61-7a}}cc{\\p{L}}cc{\\P{Greek}}cc{\\P{Lu}}}")) { ret 4; }
    if (!parses("(?i)[k]", "cc/i{6b-6b}"))                                                                              { ret 5; }
    if (!parses("[[:x]", "cc{5b-5b 3a-3a 78-78}"))                                                                      { ret 6; }
    if (!parses("[a-b-c]", "cc{61-62 2d-2d 63-63}"))                                                                    { ret 7; }
    ret 0;
}

test parse__escapes {
    if (!parses("\\x41\\x{1F600}\\101\\0\\07\\n", "cat{lit{A}lit{\\x{1f600}}lit{A}lit{\\x{0}}lit{\\x{7}}lit{\\x{a}}}")) { ret 1; }
    if (!parses("\\Qa.*\\E+", "cat{lit{a}lit{.}rep{1,*:lit{*}}}"))                                                      { ret 2; }
    if (!parses("\\Qab", "cat{lit{a}lit{b}}"))                                                                          { ret 3; }
    if (!parses("\\.\\_\\-", "cat{lit{.}lit{_}lit{-}}"))                                                                { ret 4; }
    ret 0;
}

test parse__errors {
    if (!fails("a[b", "missing closing ]", 1))                         { ret 1; }
    if (!fails("(a", "missing closing )", 0))                          { ret 2; }
    if (!fails("a)", "unexpected )", 1))                               { ret 3; }
    if (!fails("a\\", "trailing backslash at end of expression", 1))   { ret 4; }
    if (!fails("\\1", "invalid escape sequence", 0))                   { ret 5; }
    if (!fails("\\x{110000}", "invalid escape sequence", 0))           { ret 6; }
    if (!fails("\\q", "invalid escape sequence", 0))                   { ret 7; }
    if (!fails("*a", "missing argument to repetition operator", 0))    { ret 8; }
    if (!fails("(?i)*", "missing argument to repetition operator", 4)) { ret 9; }
    if (!fails("a**", "invalid nested repetition operator", 2))        { ret 10; }
    if (!fails("a{1001}", "invalid repeat count", 1))                  { ret 11; }
    if (!fails("a{3,2}", "invalid repeat count", 1))                   { ret 12; }
    if (!fails("[z-a]", "invalid character class range", 1))           { ret 13; }
    if (!fails("[[:foo:]]", "invalid character class range", 1))       { ret 14; }
    if (!fails("[a-\\d]", "invalid character class range", 1))         { ret 15; }
    if (!fails("\\p{", "invalid character class", 0))                  { ret 16; }
    if (!fails("(?P<a-b>x)", "invalid named capture", 0))              { ret 17; }
    if (!fails("(?P<x>a)(?P<x>b)", "duplicate capture group name", 8)) { ret 18; }
    if (!fails("(?z)", "invalid or unsupported Perl syntax", 0))       { ret 19; }
    if (!fails("(?i-)", "invalid or unsupported Perl syntax", 0))      { ret 20; }
    if (!fails("a\xFF", "invalid UTF-8", 1))                           { ret 21; }
    ret 0;
}

test parse__nesting_limit {
    var deep: [2003]u8;
    var i:    usize = 0;
    for (i < 1001) {
        deep[i]        = '(';
        deep[1001 + i] = ')';
        i              = i + 1;
    }
    deep[2002] = 0;
    if (!fails(?deep[0], "expression nests too deeply", 1000)) { ret 1; }
    var shallow: [2001]u8;
    i = 0;
    for (i < 1000) {
        shallow[i]        = '(';
        shallow[1000 + i] = ')';
        i                 = i + 1;
    }
    shallow[2000] = 0;
    var t: testing.Testing;
    testing.make(?t);
    var flags: syntax.Flags;
    var got:   res[syntax.Ast, syntax.Error] = parse_with(testing.allocator_of(?t), ?shallow[0], flags);
    if (sel got.err) {
        testing.dnit(?t);
        ret 2;
    }
    syntax.dnit(?got.ok);
    testing.dnit(?t);
    ret 0;
}

# every allocation the parser makes can fail, and each failure frees what it took
test parse__allocation_failures {
    var n: usize = 1;
    for (n < 200) {
        var t: testing.Testing;
        testing.make(?t);
        testing.fail_at_ordinal(?t, n);
        var flags: syntax.Flags;
        var got:   res[syntax.Ast, syntax.Error] = parse_with(testing.allocator_of(?t), "(?P<n>a|[b-d\\pL])*x{2}", flags);
        if (sel got.ok) {
            syntax.dnit(?got.ok);
            val done: bool = testing.leaked(?t);
            testing.dnit(?t);
            if (done) { ret 1; }
            ret 0;
        }
        if (!str_equals(syntax.text(got.err.kind), "out of memory")) {
            testing.dnit(?t);
            ret 2;
        }
        if (testing.leaked(?t)) {
            testing.dnit(?t);
            ret 3;
        }
        testing.dnit(?t);
        n = n + 1;
    }
    ret 4;
}
