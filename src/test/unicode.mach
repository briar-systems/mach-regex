# unicode class tables and case folding, spot-checked against the ucd

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.option.opt;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;
use std.types.view.view;

use regex.unicode;

#[testing]
fun table(name: str) opt[unicode.Table] {
    ret unicode.class(view(name, str_len(name)));
}

#[testing]
fun known(name: str) bool {
    val t: opt[unicode.Table] = table(name);
    ret sel t.some;
}

#[testing]
fun contains(name: str, cp: u32) bool {
    val t: opt[unicode.Table] = table(name);
    if (sel t.none) { ret false; }
    var i: usize = 0;
    for (i < t.some.len) {
        if (cp >= t.some.ranges[i].lo && cp <= t.some.ranges[i].hi) { ret true; }
        i = i + 1;
    }
    ret false;
}

test class__categories {
    if (!contains("Lu", 'A') || contains("Lu", 'a') || !contains("Ll", 'a'))        { ret 1; }
    if (!contains("L", 'a') || !contains("L", 0x4E00) || contains("L", '0'))        { ret 2; }
    if (!contains("Nd", '9') || !contains("Nd", 0x0660) || contains("Nd", 'a'))     { ret 3; }
    if (!contains("N", 0x2167) || !contains("Cs", 0xDBFF) || contains("C", 0x0378)) { ret 4; }
    val nd: opt[unicode.Table] = table("Nd");
    if (sel nd.none)                                                { ret 5; }
    if (nd.some.ranges[0].lo != '0' || nd.some.ranges[0].hi != '9') { ret 6; }
    ret 0;
}

test class__scripts {
    if (!contains("Greek", 0x03B1) || contains("Greek", 'a') || !contains("Latin", 'a'))        { ret 1; }
    if (!contains("Han", 0x4E00) || !contains("Common", '0') || !contains("Inherited", 0x0300)) { ret 2; }
    ret 0;
}

test class__any_and_unknown {
    val any: opt[unicode.Table] = table("Any");
    if (sel any.none)                                                                         { ret 1; }
    if (any.some.len != 1 || any.some.ranges[0].lo != 0 || any.some.ranges[0].hi != 0x10FFFF) { ret 2; }
    if (known("greek") || known("Gree") || known("Greeks") || known(""))                      { ret 3; }
    ret 0;
}

test simple_fold__orbits {
    if (unicode.simple_fold('K') != 'k' || unicode.simple_fold('k') != 0x212A || unicode.simple_fold(0x212A) != 'K') { ret 1; }
    if (unicode.simple_fold('A') != 'a' || unicode.simple_fold('a') != 'A')                                          { ret 2; }
    if (unicode.simple_fold('1') != '1' || unicode.simple_fold(0x10FFFF) != 0x10FFFF)                                { ret 3; }
    ret 0;
}
