#!/usr/bin/env python3
"""generate src/unicode/*.mach, the unicode tables, from the pinned ucd

the general categories (every two-letter category in UnicodeData.txt and the
one-letter unions of them), the scripts of Scripts.txt, Any, and the simple
case folding orbits of CaseFolding.txt (statuses C and S), as RE2 takes them.
the ucd files are downloaded from unicode.org into tools/.ucd/<version>/, which
is never committed, and checked against their pinned sha-256 before use.

usage: tools/unicode-tables [--check]
"""

import collections
import hashlib
import pathlib
import sys
import urllib.request

VERSION = '18.0.0'
FILES = {
    'UnicodeData.txt': '0736451de439ae7baf1425136617da495e09ee5afbe6e394374db7009ea08950',
    'Scripts.txt': '0071fd81b6aeae25f6e8bce8efec3066a6476a91b49bdb2f52dc76e817862a6a',
    'CaseFolding.txt': 'a004797658a457bec4dc11683e39f69249ea3b595b752dbea6721c4c9f587b0d',
}
MAX = 0x10FFFF
PER_LINE = 8

ROOT = pathlib.Path(__file__).resolve().parent.parent
CACHE = ROOT / 'tools' / '.ucd' / VERSION
OUTPUT = ROOT / 'src' / 'unicode'


def fetch(name):
    path = CACHE / name
    if not path.exists():
        CACHE.mkdir(parents=True, exist_ok=True)
        url = f'https://www.unicode.org/Public/{VERSION}/ucd/{name}'
        with urllib.request.urlopen(url) as response:
            data = response.read()
        path.write_bytes(data)
    data = path.read_bytes()
    digest = hashlib.sha256(data).hexdigest()
    if digest != FILES[name]:
        sys.exit(f'{path} has sha-256 {digest}, not the pinned {FILES[name]}; delete it and rerun')
    return data.decode('utf-8')


def records(text):
    for line in text.splitlines():
        line = line.split('#', 1)[0].strip()
        if line:
            yield [field.strip() for field in line.split(';')]


def span(field):
    lo, _, hi = field.partition('..')
    return int(lo, 16), int(hi or lo, 16)


def ranges(points):
    out = []
    for cp in sorted(points):
        if out and out[-1][1] + 1 == cp:
            out[-1][1] = cp
        else:
            out.append([cp, cp])
    return [tuple(r) for r in out]


def categories():
    groups = collections.defaultdict(set)
    first = None
    for fields in records(fetch('UnicodeData.txt')):
        cp, name, cat = int(fields[0], 16), fields[1], fields[2]
        if name.endswith(', First>'):
            first = cp
            continue
        lo = cp
        if name.endswith(', Last>'):
            lo, first = first, None
        points = range(lo, cp + 1)
        groups[cat].update(points)
        groups[cat[0]].update(points)
    return groups


def scripts():
    groups = collections.defaultdict(set)
    for fields in records(fetch('Scripts.txt')):
        lo, hi = span(fields[0])
        groups[fields[1]].update(range(lo, hi + 1))
    return groups


def orbits():
    folds = collections.defaultdict(set)
    for fields in records(fetch('CaseFolding.txt')):
        if fields[1] in ('C', 'S'):
            cp, target = int(fields[0], 16), int(fields[2], 16)
            folds[target].update((cp, target))
    step = {}
    for orbit in folds.values():
        cycle = sorted(orbit)
        for i, cp in enumerate(cycle):
            assert cp not in step, f'U+{cp:04X} is in two orbits'
            step[cp] = cycle[(i + 1) % len(cycle)]
    return step


def header(summary):
    return [
        f'# {summary}',
        '#',
        '# generated by tools/unicode-tables from the unicode character database',
        f'# {VERSION}. do not edit: rerun the generator.',
        '',
    ]


def words(values):
    lines = []
    for i in range(0, len(values), PER_LINE):
        lines.append('    ' + ', '.join(f'0x{v:06X}' for v in values[i:i + PER_LINE]) + ',')
    return lines


def render_version():
    lines = header('the unicode version the tables are generated from')
    lines += [
        'use std.types.string.str;',
        '',
        '# the unicode version, as major.minor.update',
        f'pub val VERSION: str = "{VERSION}";',
    ]
    return '\n'.join(lines) + '\n'


def render_classes():
    tables = {}
    tables.update(categories())
    tables.update(scripts())
    tables['Any'] = set(range(0, MAX + 1))
    names = sorted(tables)
    assert all(name.isascii() for name in names)
    pool, starts, counts = [], [], []
    for name in names:
        rs = ranges(tables[name])
        starts.append(len(pool) // 2)
        counts.append(len(rs))
        for lo, hi in rs:
            pool += [lo, hi]
    lines = header('class name to range table: general categories, scripts and Any')
    lines += [
        'use std.types.string.str;',
        '',
        f'pub val COUNT: u32 = {len(names)};',
        '',
        '# class names, sorted by byte',
        f'pub val NAMES: [{len(names)}]str = [{len(names)}]str{{',
    ]
    lines += [f'    "{name}",' for name in names]
    lines += [
        '};',
        '',
        '# first range of each class in RANGES, in the order of NAMES',
        f'pub val STARTS: [{len(names)}]u32 = [{len(names)}]u32{{',
    ]
    lines += words(starts)
    lines += [
        '};',
        '',
        '# number of ranges of each class, in the order of NAMES',
        f'pub val COUNTS: [{len(names)}]u32 = [{len(names)}]u32{{',
    ]
    lines += words(counts)
    lines += [
        '};',
        '',
        '# every class\'s ranges as lo, hi pairs, both inclusive, sorted and disjoint',
        f'pub val RANGES: [{len(pool)}]u32 = [{len(pool)}]u32{{',
    ]
    lines += words(pool)
    lines.append('};')
    return '\n'.join(lines) + '\n'


def render_folds():
    step = orbits()
    pairs = []
    for cp in sorted(step):
        pairs += [cp, step[cp]]
    lines = header('simple case folding orbits')
    lines += [
        f'pub val COUNT: u32 = {len(step)};',
        '',
        '# code point, next in its orbit: sorted by code point, one per folding code point',
        f'pub val FOLDS: [{len(pairs)}]u32 = [{len(pairs)}]u32{{',
    ]
    lines += words(pairs)
    lines.append('};')
    return '\n'.join(lines) + '\n'


def main():
    outputs = {
        'version.mach': render_version(),
        'classes.mach': render_classes(),
        'folds.mach': render_folds(),
    }
    if sys.argv[1:] == ['--check']:
        stale = [name for name, text in outputs.items()
                 if not (OUTPUT / name).exists() or (OUTPUT / name).read_text() != text]
        if stale:
            sys.exit(f'{", ".join(stale)} stale; run tools/unicode-tables')
        return
    if sys.argv[1:]:
        sys.exit(__doc__)
    OUTPUT.mkdir(parents=True, exist_ok=True)
    for name, text in outputs.items():
        (OUTPUT / name).write_text(text)


if __name__ == '__main__':
    main()
